{
    "id": "dev.illapa.Remuxer",
    "runtime": "org.gnome.Platform",
    "runtime-version": "50",
    "sdk": "org.gnome.Sdk",
    "command": "remuxer",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--device=dri",
        "--socket=wayland"
    ],
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        "ffmpeg.yaml",
        "python3-requirements.json",
        {
            "name": "remuxer",
            "builddir": true,
            "buildsystem": "meson",
            "config-opts": [],
            "sources": [
                {
                    "type": "dir",
                    "path": "./"
                }
            ]
        }
    ],
    "build-options": {
        "env": {}
    }
}