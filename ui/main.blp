using Gtk 4.0;
using Adw 1;

template $MainWindow: Adw.ApplicationWindow {
  default-width: 900;
  default-height: 800;
  title: _("Procesador de Episodios");

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      [title]
      Adw.WindowTitle {
        title: _("Procesador de Episodios");
      }
    }

    content: Gtk.Box {
      orientation: vertical;
      spacing: 18;
      margin-top: 24;
      margin-bottom: 24;
      margin-start: 24;
      margin-end: 24;
      // --- SECCIÓN 1: SELECCIÓN DE RUTAS ---
      Adw.PreferencesGroup {
        title: _("Fuentes de medios");

        Adw.EntryRow entry_videos_principales {
          title: _("Carpeta de Videos");
          editable: false;

          [suffix]
          Button btn_seleccionar_videos_principales {
            icon-name: "folder-open-symbolic";

            styles [
              "flat",
            ]
          }
        }

        Adw.EntryRow entry_videos_audio {
          title: _("Carpeta de Audios");
          editable: false;

          [suffix]
          Button btn_seleccionar_videos_audio {
            icon-name: "folder-open-symbolic";

            styles [
              "flat",
            ]
          }
        }
      }

      // --- SECCIÓN 2: TABLA Y CONTROLES DE ORDEN ---
      Gtk.Box {
        orientation: vertical;
        spacing: 12;
        vexpand: true;
        // Barra de herramientas de la lista
        Gtk.Box {
          orientation: horizontal;
          spacing: 12;

          Gtk.Label {
            label: _("Alineación de Episodios");

            styles [
              "heading",
            ]

            hexpand: true;
            halign: start;
          }

          // Controles para VIDEO
          Gtk.Box {
            orientation: horizontal;
            spacing: 6;

            Gtk.Label {
              label: _("Video:");

              styles [
                "caption",
              ]
            }

            Gtk.Box {
              styles [
                "linked",
              ]

              Button btn_video_subir {
                icon-name: "go-up-symbolic";
                tooltip-text: _("Subir Video");
              }

              Button btn_video_bajar {
                icon-name: "go-down-symbolic";
                tooltip-text: _("Bajar Video");
              }
            }
          }

          Gtk.Separator {
            styles [
              "spacer",
            ]
          }

          // Controles para AUDIO
          Gtk.Box {
            orientation: horizontal;
            spacing: 6;

            Gtk.Label {
              label: _("Audio:");

              styles [
                "caption",
              ]
            }

            Gtk.Box {
              styles [
                "linked",
              ]

              Button btn_audio_subir {
                icon-name: "go-up-symbolic";
                tooltip-text: _("Subir Audio");
              }

              Button btn_audio_bajar {
                icon-name: "go-down-symbolic";
                tooltip-text: _("Bajar Audio");
              }
            }
          }
        }

        // El área de la lista
        Gtk.Frame {
          child: Gtk.ScrolledWindow {
            min-content-height: 350;

            child: Gtk.ColumnView view_episodios {
              hexpand: true;
              vexpand: true;
              // Las columnas se definen en el código
            };
          };
        }
      }

      // --- SECCIÓN 3: SALIDA Y EJECUCIÓN ---
      Gtk.Box {
        orientation: vertical;
        spacing: 12;

        Adw.PreferencesGroup {
          Adw.EntryRow entry_directorio_salida {
            title: _("Destino Final");
            editable: false;

            [suffix]
            Button btn_seleccionar_salida {
              icon-name: "folder-open-symbolic";

              styles [
                "flat",
              ]
            }
          }
        }

        Gtk.Box {
          halign: center;
          spacing: 18;

          Button btn_analizar {
            label: _("Analizar Archivos");
            width-request: 200;

            styles [
              "pill",
            ]
          }

          Button btn_procesar {
            label: _("Iniciar Procesamiento");
            width-request: 200;
            sensitive: false;

            styles [
              "suggested-action",
              "pill",
            ]
          }
        }

        Gtk.ProgressBar pro_bar {
          margin-top: 6;
        }
      }
    };
  };
}
