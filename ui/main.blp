using Gtk 4.0;

ApplicationWindow MainWindow {
  child: Box {
    margin-bottom: 24;
    margin-end: 24;
    margin-start: 24;
    margin-top: 24;
    orientation: vertical;
    spacing: 24;

    Box {
      orientation: vertical;
      spacing: 18;

      Label {
        label: "Directorios";
        xalign: 0;

        styles [
          "title-3",
        ]
      }

      Grid {
        column-spacing: 12;
        row-spacing: 12;

        Entry entry_videos_principales {
          editable: false;
          hexpand: true;
          placeholder-text: "Selecciona la carpeta de los vídeos principales";

          layout {
            column: "0";
            row: "0";
          }
        }

        Button btn_seleccionar_videos_principales {
          icon-name: "folder-open-symbolic";
          tooltip-text: "Seleccionar carpeta";

          layout {
            column: "1";
            row: "0";
          }
        }

        Entry entry_videos_audio {
          editable: false;
          hexpand: true;
          placeholder-text: "Selecciona la carpeta del audio";

          layout {
            column: "0";
            row: "1";
          }
        }

        Button btn_seleccionar_videos_audio {
          icon-name: "folder-open-symbolic";
          tooltip-text: "Seleccionar carpeta";

          layout {
            column: "1";
            row: "1";
          }
        }

        Entry entry_directorio_salida {
          editable: false;
          hexpand: true;
          placeholder-text: "Selecciona el directorio de salida";

          layout {
            column: "0";
            row: "2";
          }
        }

        Button btn_seleccionar_salida {
          icon-name: "folder-open-symbolic";
          tooltip-text: "Seleccionar carpeta";

          layout {
            column: "1";
            row: "2";
          }
        }
      }
    }

    Paned {
      end-child: Box {
        orientation: vertical;
        spacing: 12;
        width-request: 180;

        Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: "Vídeo principal";
            xalign: 0;

            styles [
              "heading",
            ]
          }

          Button btn_video_subir {
            icon-name: "go-up-symbolic";
            tooltip-text: "Mover arriba";
          }

          Button btn_video_bajar {
            icon-name: "go-down-symbolic";
            tooltip-text: "Mover abajo";
          }

          Button btn_video_eliminar {
            icon-name: "user-trash-symbolic";
            tooltip-text: "Eliminar";
          }
        }

        Separator {
          orientation: horizontal;
        }

        Box {
          orientation: vertical;
          spacing: 12;

          Label {
            label: "Audio";
            xalign: 0;

            styles [
              "heading",
            ]
          }

          Button btn_audio_subir {
            icon-name: "go-up-symbolic";
            tooltip-text: "Mover arriba";
          }

          Button btn_audio_bajar {
            icon-name: "go-down-symbolic";
            tooltip-text: "Mover abajo";
          }

          Button btn_audio_eliminar {
            icon-name: "user-trash-symbolic";
            tooltip-text: "Eliminar";
          }
        }
      };

      hexpand: true;
      orientation: horizontal;

      start-child: Box {
        orientation: vertical;
        spacing: 12;

        Label {
          label: "Emparejamiento de episodios";
          xalign: 0;

          styles [
            "title-4",
          ]
        }

        ScrolledWindow {
          child: ColumnView view_episodios {
            hexpand: true;
            vexpand: true;
          };

          hexpand: true;
          vexpand: true;
        }
      };

      vexpand: true;
      wide-handle: true;
    }

    Box {
      halign: end;

      Button btn_procesar {
        height-request: 42;
        label: "Procesar";
        width-request: 180;

        styles [
          "suggested-action",
        ]
      }
    }
  };
}
